/* ============================================================
   testPrivateLobby.uss — Sci-fi Private Lobby Stylesheet
   Consistent design language with testMainMenu.uss
   ============================================================ */

:root {
    --color-bg-dark: rgba(8, 14, 22, 0.88);
    --color-panel-bg: rgba(6, 12, 22, 0.85);
    --color-accent-cyan: rgb(0, 240, 255);
    --color-accent-cyan-dim: rgba(0, 240, 255, 0.25);
    --color-accent-cyan-glow: rgba(0, 240, 255, 0.12);
    --color-accent-yellow: rgb(255, 196, 0);
    --color-accent-red: rgb(255, 80, 80);
    --color-text-white: rgb(230, 242, 255);
    --color-text-grey: rgba(200, 220, 240, 0.6);
}

/* ── Full-screen background ── */
.lobby-background {
    flex-grow: 1;
    background-image: url("project://database/Assets/%C4%B0mages/menuback.png?fileID=-41123892&guid=f2c5c63a073280043b1e1681fe2b87c1&type=3#menuback_0");
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}

.lobby-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(5, 10, 18, 0.5);
}

/* ── Central card panel ── */
.lobby-card {
    width: 580px;
    min-height: 420px;
    background-color: rgba(6, 12, 22, 0.88);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.2);
    border-radius: 10px;
    padding: 50px 45px;
    align-items: stretch;
}

/* ── Panel header ── */
.panel-header {
    margin-bottom: 35px;
    align-items: center;
}

.panel-title {
    color: rgb(0, 240, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.panel-subtitle {
    color: rgba(200, 220, 240, 0.55);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.panel-separator {
    height: 1px;
    background-color: rgba(0, 240, 255, 0.15);
    margin-top: 12px;
}

/* ── Primary button (large / action) ── */
.lobby-btn-primary {
    height: 60px;
    margin-bottom: 16px;
    background-color: rgba(0, 240, 255, 0.08);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(0, 240, 255, 0.3);
    border-left-color: rgba(0, 240, 255, 0.5);
    border-radius: 5px;
    color: rgb(200, 230, 255);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, border-left-color, color, translate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.lobby-btn-primary:hover {
    background-color: rgba(0, 240, 255, 0.15);
    border-color: rgb(0, 240, 255);
    border-left-color: rgb(0, 240, 255);
    color: rgb(0, 240, 255);
    scale: 1.02 1.02;
    translate: 6px 0;
}

.lobby-btn-primary:active {
    background-color: rgba(0, 240, 255, 0.28);
    scale: 0.98 0.98;
    translate: 3px 0;
}

/* ── Start game button — special green accent ── */
.lobby-btn-start {
    height: 56px;
    margin-top: 10px;
    margin-bottom: 12px;
    background-color: rgba(0, 200, 120, 0.1);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(0, 200, 120, 0.35);
    border-left-color: rgba(0, 200, 120, 0.6);
    border-radius: 5px;
    color: rgb(100, 240, 180);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, border-left-color, color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.lobby-btn-start:hover {
    background-color: rgba(0, 200, 120, 0.2);
    border-color: rgb(0, 220, 140);
    border-left-color: rgb(0, 220, 140);
    color: rgb(0, 255, 160);
    scale: 1.02 1.02;
}

.lobby-btn-start:active {
    background-color: rgba(0, 200, 120, 0.35);
    scale: 0.98 0.98;
}

/* ── Secondary / back button ── */
.lobby-btn-secondary {
    height: 44px;
    margin-top: 8px;
    background-color: rgba(255, 80, 80, 0.06);
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.25);
    border-radius: 5px;
    color: rgba(255, 120, 120, 0.8);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.lobby-btn-secondary:hover {
    background-color: rgba(255, 80, 80, 0.15);
    border-color: rgb(255, 80, 80);
    color: rgb(255, 100, 100);
    scale: 1.01 1.01;
}

.lobby-btn-secondary:active {
    background-color: rgba(255, 80, 80, 0.25);
    scale: 0.98 0.98;
}

/* ── Room code display ── */
.room-code-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 22px;
    padding: 14px 20px;
    background-color: rgba(0, 240, 255, 0.05);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.2);
    border-radius: 6px;
}

.room-code-label {
    color: rgba(200, 220, 240, 0.6);
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.room-code-value {
    color: rgb(255, 196, 0);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

/* ── Player list ── */
.player-list-header {
    color: rgba(0, 240, 255, 0.6);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.player-list-container {
    flex-grow: 1;
    min-height: 160px;
    max-height: 240px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.1);
    border-radius: 5px;
    padding: 10px 14px;
    margin-bottom: 16px;
}

.player-list-container .unity-scroll-view {
    flex-grow: 1;
}

.player-item {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.player-icon {
    width: 8px;
    height: 8px;
    background-color: rgb(0, 200, 120);
    border-radius: 4px;
    margin-right: 12px;
}

.player-name {
    color: rgb(220, 235, 255);
    font-size: 14px;
}

/* ── Join code text field ── */
.join-code-field {
    height: 52px;
    margin-bottom: 20px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.25);
    border-radius: 5px;
    color: rgb(230, 242, 255);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.join-code-field .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    color: rgb(255, 196, 0);
    font-size: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    padding: 8px 16px;
}

.join-code-field:focus .unity-text-field__input {
    border-width: 0;
    background-color: rgba(0, 240, 255, 0.05);
}

.join-code-hint {
    color: rgba(200, 220, 240, 0.4);
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

/* ── Utility ── */
.hidden {
    display: none;
}
