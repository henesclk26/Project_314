<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/ComputerScreen.uss?fileID=7433441132597879392&amp;guid=3b5808da99ad6324cbb7383a2a94a40d&amp;type=3#ComputerScreen"/>
    <ui:VisualElement name="game-version-label" style="flex-grow: 1; position: absolute; height: 119px; width: 342px; bottom: 3px; left: 3px; color: rgb(255, 255, 255);">
        <ui:Label text="v0.0.22" style="height: 109px; width: 328px; font-size: 36px; color: rgb(156, 156, 156); -unity-text-align: lower-left;"/>
    </ui:VisualElement>
    <ui:VisualElement name="hud-top-left" style="position: absolute; top: 20px; left: 20px; background-color: rgba(6, 12, 22, 0.8); border-radius: 8px; padding: 10px; border-width: 2px; border-color: rgba(0, 240, 255, 0.5);">
        <ui:Label name="crew-progress-label" text="GÖREV İLERLEMESİ: 0 / 0" style="color: rgb(0, 255, 255); font-size: 18px; -unity-font-style: bold; margin-bottom: 8px;"/>
        <ui:VisualElement name="crew-progress-track" style="height: 8px; width: 100%; margin-bottom: 8px; background-color: rgba(0, 255, 255, 0.18); border-radius: 4px; overflow: hidden;">
            <ui:VisualElement name="crew-progress-fill" style="height: 100%; width: 0%; background-color: rgb(0, 255, 255); border-radius: 4px;"/>
        </ui:VisualElement>
        <ui:Label name="current-task-label" text="AKTİF GÖREV: YOK" style="color: rgb(220, 220, 220); font-size: 16px; margin-bottom: 4px;"/>
        <ui:Label name="current-room-label" text="" style="color: rgb(150, 150, 150); font-size: 14px;"/>
        <ui:Label name="kill-cooldown-label" text="" style="display: none; color: rgb(255, 132, 114); font-size: 14px; -unity-font-style: bold; margin-top: 8px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="killer-hack-panel" style="position: absolute; top: 270px; left: 20px; width: 342px; display: none; background-color: rgba(26, 7, 12, 0.9); border-left-width: 3px; border-left-color: rgb(224, 69, 63); border-top-width: 1px; border-top-color: rgba(255, 125, 110, 0.45); padding: 10px;">
        <ui:Label text="ROGUE HACK STATIONS" style="color: rgb(255, 132, 114); font-size: 13px; -unity-font-style: bold; margin-bottom: 7px;"/>
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 5px;">
            <ui:Label text="MISSION COMPUTER" style="color: rgb(228, 224, 222); font-size: 12px;"/>
            <ui:Label name="killer-hack-status-computer" text="LOCKED" style="color: rgb(164, 135, 132); font-size: 11px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 5px;">
            <ui:Label text="CIRCUIT MISSION" style="color: rgb(228, 224, 222); font-size: 12px;"/>
            <ui:Label name="killer-hack-status-circuit" text="LOCKED" style="color: rgb(164, 135, 132); font-size: 11px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
            <ui:Label text="WAVE TERMINAL" style="color: rgb(228, 224, 222); font-size: 12px;"/>
            <ui:Label name="killer-hack-status-wave" text="LOCKED" style="color: rgb(164, 135, 132); font-size: 11px; -unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="basketball-task-panel" picking-mode="Ignore" style="position: absolute; top: 20px; right: 20px; width: 300px; display: none; background-color: rgba(6, 12, 22, 0.92); border-width: 2px; border-color: rgba(0, 240, 255, 0.72); border-radius: 8px; padding: 14px;">
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <ui:Label text="ARCADE // LIVE" style="color: rgb(0, 240, 255); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px;"/>
            <ui:Label name="basketball-time-label" text="30 SEC" style="color: rgb(255, 210, 102); font-size: 18px; -unity-font-style: bold; -unity-font-variant: small-caps;"/>
        </ui:VisualElement>
        <ui:VisualElement name="basketball-time-track" style="height: 6px; width: 100%; margin-bottom: 12px; background-color: rgba(255, 210, 102, 0.18); border-radius: 3px; overflow: hidden;">
            <ui:VisualElement name="basketball-time-fill" style="height: 100%; width: 100%; background-color: rgb(255, 210, 102); border-radius: 3px;"/>
        </ui:VisualElement>
        <ui:Label text="BASKETS MADE" style="color: rgb(150, 190, 205); font-size: 11px; -unity-font-style: bold; margin-bottom: 2px;"/>
        <ui:Label name="basketball-score-label" text="0 / 10" style="color: rgb(245, 250, 252); font-size: 28px; -unity-font-style: bold; margin-bottom: 8px;"/>
        <ui:Label name="basketball-input-hint" text="[LMB] THROW   //   [ESC] EXIT" style="color: rgb(0, 240, 255); font-size: 11px; -unity-font-style: bold;"/>
    </ui:VisualElement>
    <ui:VisualElement name="role-badge" class="role-badge hidden">
        <ui:Label name="role-badge-text" text="" class="role-badge-label"/>
    </ui:VisualElement>
    <ui:VisualElement name="valve-warning-image" style="position: absolute; right: 40px; top: 40px; width: 320px; height: 180px; display: none; border-radius: 15px; overflow: hidden; border-width: 2px; border-color: rgba(255, 0, 0, 0.5); background-image: url(&quot;project://database/Assets/%C4%B0mages/pressure%20warning.png?fileID=2800000&amp;guid=3ca4c1093171f24409d66950b788c279&amp;type=3#pressure warning&quot;);"/>
    <ui:VisualElement name="game-prompt-container" class="prompt-container hidden">
        <ui:VisualElement class="prompt-box">
            <ui:Label text="F" class="prompt-key"/>
            <ui:Label name="game-prompt-text" text="Etkileşim" class="prompt-text"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="role-reveal-overlay" class="role-reveal-overlay hidden">
        <ui:VisualElement name="role-reveal-frame" class="role-reveal-frame">
            <ui:Label text="IDENTITY PROTOCOL // SECURE CHANNEL" class="role-reveal-kicker"/>
            <ui:VisualElement class="role-reveal-rule"/>
            <ui:Label name="role-reveal-title" text="KÖYLÜ" class="role-reveal-title"/>
            <ui:Label name="role-reveal-subtitle" text="CREW MEMBER // GÖREVLERİNİ TAMAMLA" class="role-reveal-subtitle"/>
            <ui:VisualElement class="role-reveal-spacer"/>
            <ui:VisualElement class="role-reveal-progress-track">
                <ui:VisualElement name="role-reveal-progress-fill" class="role-reveal-progress-fill"/>
            </ui:VisualElement>
            <ui:Label name="role-reveal-timer" text="2.0 SEC" class="role-reveal-timer"/>
            <ui:Label name="role-reveal-status" text="MATCH INITIALIZING..." class="role-reveal-status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
