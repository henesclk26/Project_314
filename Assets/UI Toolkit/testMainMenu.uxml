<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/testMainMenu.uss?fileID=7433441132597879392&amp;guid=d36169e16bb2d7f41be6d736c48acf1c&amp;type=3#testMainMenu"/>
    <ui:VisualElement class="menu-background">
        <ui:VisualElement class="menu-overlay" style="top: -1px; bottom: 2px; right: 0; left: 0;"/>
        <ui:VisualElement class="menu-left-panel">
            <ui:VisualElement class="logo-container">
                <ui:VisualElement class="logo-img"/>
            </ui:VisualElement>
            <ui:VisualElement class="title-separator">
                <ui:VisualElement class="title-separator-dot"/>
            </ui:VisualElement>
            <ui:VisualElement class="button-container">
                <ui:Button name="btn-private-game" text="PRIVATE GAME" class="menu-btn"/>
                <ui:Button name="btn-public-game" text="PUBLIC GAME" class="menu-btn"/>
                <ui:Button name="btn-settings" text="SETTINGS" class="menu-btn"/>
                <ui:Button name="btn-quit-game" text="QUIT GAME" class="menu-btn"/>
                <ui:Button name="btn-quick-test" text="QUICK TEST" class="menu-btn menu-btn-test"/>
            </ui:VisualElement>
            <ui:VisualElement class="menu-footer">
                <ui:Label text="SYSTEM STATUS: ONLINE" class="footer-version"/>
                <ui:Label text="v0.0.16" class="footer-credits" style="width: 72px; height: 44px; -unity-text-align: upper-center; font-size: 24px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement enabled="false" class="menu-right-panel">
            <ui:Label text="MISSION OBJECTIVE" class="info-title"/>
            <ui:VisualElement class="info-content">
                <ui:Label text="A severe energy anomaly has been detected in Sector 7. Coordinate with your team to locate and power up the backup generators." class="info-text"/>
                <ui:Label text="CAUTION: Space-time distortions are active. Watch out for unpredictable gravity flips, controls reversal, and spatial shifts." class="info-text"/>
            </ui:VisualElement>
            <ui:Label text="CONTROLS" class="info-title"/>
            <ui:VisualElement class="controls-grid">
                <ui:VisualElement class="control-row">
                    <ui:Label text="MOVE" class="control-action"/>
                    <ui:Label text="W / A / S / D" class="control-key-box"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="INTERACT" class="control-action"/>
                    <ui:Label text="F" class="control-key-box"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="CAMERA VIEW" class="control-action"/>
                    <ui:Label text="V" class="control-key-box"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="ESC MENU" class="control-action"/>
                    <ui:Label text="ESCAPE" class="control-key-box"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
