:root {
    --bg: rgba(2, 8, 14, 0.98);
    --panel: rgba(5, 15, 24, 0.99);
    --panel-soft: rgba(9, 27, 40, 0.94);
    --cyan: rgb(0, 232, 245);
    --cyan-soft: rgba(0, 232, 245, 0.25);
    --green: rgb(0, 255, 136);
    --text: rgb(214, 239, 245);
    --muted: rgb(104, 148, 160);
    --danger: rgb(255, 78, 86);
}

.hidden {
    display: none;
}

.terminal-prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 62px;
    align-items: center;
    justify-content: center;
}

.terminal-prompt-box {
    flex-direction: row;
    align-items: center;
    padding: 9px 16px;
    background-color: rgba(3, 12, 20, 0.94);
    border-width: 1px;
    border-color: var(--cyan);
    border-radius: 5px;
}

.terminal-prompt-key {
    width: 34px;
    height: 34px;
    margin-right: 11px;
    background-color: var(--cyan);
    color: rgb(0, 15, 20);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 4px;
}

.terminal-prompt-text {
    color: var(--text);
    font-size: 18px;
    -unity-font-style: bold;
}

.security-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 3, 7, 0.94);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.security-overlay.open {
    opacity: 1;
}

.security-panel {
    width: 94%;
    height: 92%;
    min-width: 980px;
    min-height: 620px;
    padding: 22px 26px 15px 26px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: rgba(0, 232, 245, 0.48);
    scale: 0.985 0.985;
    transition-property: scale;
    transition-duration: 0.18s;
}

.security-overlay.open .security-panel {
    scale: 1 1;
}

.panel-corner {
    position: absolute;
    width: 25px;
    height: 25px;
    border-color: var(--cyan);
}

.corner-top-left { left: -2px; top: -2px; border-left-width: 3px; border-top-width: 3px; }
.corner-top-right { right: -2px; top: -2px; border-right-width: 3px; border-top-width: 3px; }
.corner-bottom-left { left: -2px; bottom: -2px; border-left-width: 3px; border-bottom-width: 3px; }
.corner-bottom-right { right: -2px; bottom: -2px; border-right-width: 3px; border-bottom-width: 3px; }

.security-header {
    height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cyan-soft);
}

.title-group,
.header-right,
.network-indicator,
.live-cluster,
.detail-status {
    flex-direction: row;
    align-items: center;
}

.security-emblem {
    width: 48px;
    height: 48px;
    margin-right: 15px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--cyan);
    border-radius: 24px;
    background-color: rgba(0, 232, 245, 0.08);
}

.emblem-lens {
    width: 20px;
    height: 20px;
    border-width: 3px;
    border-color: var(--cyan);
    border-radius: 10px;
    background-color: rgba(0, 232, 245, 0.16);
}

.screen-title {
    color: var(--text);
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.screen-subtitle,
.section-microcopy {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 1.2px;
}

.network-indicator {
    margin-right: 18px;
    padding: 7px 12px;
    background-color: rgba(0, 255, 136, 0.07);
    border-width: 1px;
    border-color: rgba(0, 255, 136, 0.28);
    border-radius: 3px;
}

.live-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background-color: var(--green);
    border-radius: 4px;
}

.network-label,
.live-text {
    color: var(--green);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.close-btn {
    width: 42px;
    height: 42px;
    color: var(--text);
    background-color: rgba(255, 78, 86, 0.08);
    border-width: 1px;
    border-color: rgba(255, 78, 86, 0.5);
    border-radius: 3px;
    font-size: 18px;
    -unity-font-style: bold;
}

.close-btn:hover {
    color: white;
    background-color: rgba(255, 78, 86, 0.35);
    border-color: var(--danger);
}

.grid-view,
.detail-view {
    flex-grow: 1;
    padding-top: 14px;
}

.grid-heading {
    height: 44px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.section-caption {
    color: var(--cyan);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.feed-count {
    padding: 6px 10px;
    color: var(--green);
    background-color: rgba(0, 255, 136, 0.06);
    border-width: 1px;
    border-color: rgba(0, 255, 136, 0.25);
    font-size: 11px;
    letter-spacing: 1px;
}

.camera-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

.feed-card {
    width: 32.55%;
    height: 48.5%;
    min-height: 205px;
    padding: 0;
    background-color: var(--panel-soft);
    border-width: 1px;
    border-color: rgba(0, 232, 245, 0.24);
    border-radius: 2px;
}

.feed-card:hover {
    border-color: var(--cyan);
    background-color: rgba(10, 38, 52, 0.98);
}

.feed-card:disabled {
    opacity: 0.45;
}

.feed-header,
.feed-footer {
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.feed-header {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 232, 245, 0.16);
}

.feed-footer {
    border-top-width: 1px;
    border-top-color: rgba(0, 232, 245, 0.16);
}

.feed-id {
    color: var(--cyan);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.feed-image {
    flex-grow: 1;
    background-color: rgb(0, 4, 7);
    -unity-background-scale-mode: scale-and-crop;
}

.feed-name {
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
}

.feed-action {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.detail-view {
    padding-left: 30px;
    padding-right: 30px;
}

.detail-toolbar {
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.detail-title-group {
    align-items: center;
}

.detail-camera-name {
    color: var(--text);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.detail-camera-index {
    color: var(--cyan);
    font-size: 11px;
    letter-spacing: 1.5px;
}

.detail-monitor {
    flex-grow: 1;
    position: relative;
    margin-top: 8px;
    margin-bottom: 12px;
    background-color: rgb(0, 3, 6);
    border-width: 2px;
    border-color: rgba(0, 232, 245, 0.55);
    overflow: hidden;
}

.detail-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.monitor-scanlines {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.12;
    background-color: rgba(0, 232, 245, 0.06);
}

.monitor-frame {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 12px;
    bottom: 12px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.record-label {
    padding: 5px 8px;
    color: white;
    background-color: rgba(255, 78, 86, 0.76);
    font-size: 11px;
    -unity-font-style: bold;
}

.network-stamp {
    padding: 5px 8px;
    color: var(--cyan);
    background-color: rgba(0, 8, 14, 0.75);
    border-width: 1px;
    border-color: rgba(0, 232, 245, 0.28);
    font-size: 10px;
}

.detail-controls {
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.nav-button {
    height: 38px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--cyan);
    background-color: rgba(0, 232, 245, 0.07);
    border-width: 1px;
    border-color: rgba(0, 232, 245, 0.45);
    border-radius: 2px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.nav-button:hover {
    color: rgb(0, 10, 14);
    background-color: var(--cyan);
}

.back-button {
    min-width: 170px;
}

.camera-nav {
    min-width: 210px;
}

.navigation-hint {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.security-footer {
    height: 29px;
    margin-top: 10px;
    padding-top: 8px;
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(0, 232, 245, 0.18);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}
