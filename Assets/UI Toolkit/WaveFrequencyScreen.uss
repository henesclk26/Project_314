:root {
    --bg-deep: rgba(5, 10, 18, 0.98);
    --bg-panel: rgba(8, 14, 22, 0.98);
    --bg-surface: rgba(0, 240, 255, 0.045);
    --cyan: rgb(0, 240, 255);
    --cyan-soft: rgba(0, 240, 255, 0.34);
    --cyan-faint: rgba(0, 240, 255, 0.12);
    --yellow: rgb(255, 196, 0);
    --green: rgb(0, 255, 128);
    --red: rgb(255, 90, 90);
    --text: rgb(230, 242, 255);
    --muted: rgba(200, 220, 240, 0.62);
}

.hidden {
    display: none;
}

.wave-frequency-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 36px;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 7, 13, 0.92);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.wave-frequency-overlay.open {
    opacity: 1;
}

.wave-frequency-panel {
    width: 100%;
    max-width: 1540px;
    height: 100%;
    max-height: 920px;
    padding: 26px;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--cyan-soft);
    border-radius: 4px;
    scale: 0.97 0.97;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.wave-frequency-overlay.open .wave-frequency-panel {
    scale: 1 1;
}

.screen-header {
    height: 72px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    margin-bottom: 22px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cyan-soft);
}

.header-title-group,
.header-actions,
.legend,
.legend-item,
.section-heading-row,
.match-row,
.control-heading-row,
.key-row,
.key-command,
.system-note {
    flex-direction: row;
    align-items: center;
}

.header-icon {
    width: 30px;
    height: 30px;
    margin-right: 13px;
    background-color: var(--cyan);
    border-radius: 15px;
}

.header-title {
    color: var(--cyan);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.header-kicker {
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 1px;
}

.connection-indicator {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background-color: var(--green);
    border-radius: 4px;
}

.connection-label {
    margin-right: 18px;
    color: var(--green);
    font-size: 11px;
    -unity-font-style: bold;
}

.close-btn {
    width: 38px;
    height: 38px;
    padding: 0;
    background-color: rgba(255, 90, 90, 0.08);
    border-width: 1px;
    border-color: rgba(255, 90, 90, 0.45);
    border-radius: 19px;
    color: rgb(255, 125, 125);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.close-btn:hover {
    background-color: rgba(255, 90, 90, 0.25);
    scale: 1.08 1.08;
}

.close-btn:active {
    scale: 0.96 0.96;
}

.screen-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.wave-section {
    flex-grow: 1;
    min-width: 0;
    margin-right: 24px;
}

.control-section {
    width: 390px;
    padding-left: 24px;
    border-left-width: 1px;
    border-left-color: var(--cyan-faint);
}

.section-heading-row,
.control-heading-row,
.key-row {
    justify-content: space-between;
}

.section-title {
    color: var(--text);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.section-subtitle,
.control-subtitle {
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
}

.legend-item {
    margin-left: 18px;
}

.legend-line {
    width: 22px;
    height: 3px;
    margin-right: 7px;
    border-radius: 1px;
}

.target-line {
    background-color: var(--cyan);
}

.live-line {
    background-color: var(--yellow);
}

.legend-label {
    color: var(--muted);
    font-size: 11px;
    -unity-font-style: bold;
}

.waveform-canvas {
    flex-grow: 1;
    min-height: 360px;
    margin-top: 18px;
    margin-bottom: 18px;
    background-color: rgb(3, 11, 17);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.28);
    border-radius: 3px;
    overflow: hidden;
}

.scope-readout {
    position: absolute;
    top: 10px;
    color: rgba(0, 240, 255, 0.48);
    font-size: 10px;
    -unity-font-style: bold;
}

.scope-readout-left {
    left: 12px;
}

.scope-readout-right {
    right: 12px;
}

.match-row {
    height: 40px;
}

.match-label {
    width: 118px;
    color: var(--muted);
    font-size: 11px;
    -unity-font-style: bold;
}

.match-track {
    flex-grow: 1;
    height: 8px;
    background-color: rgba(0, 240, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
}

.match-progress-fill {
    width: 0%;
    height: 100%;
    background-color: var(--yellow);
    border-radius: 2px;
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.match-percent {
    width: 58px;
    margin-left: 12px;
    color: var(--yellow);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.control-block {
    margin-top: 18px;
    padding: 18px;
    background-color: var(--bg-surface);
    border-width: 1px;
    border-color: var(--cyan-faint);
    border-radius: 4px;
}

.control-title {
    color: var(--cyan);
    font-size: 15px;
    -unity-font-style: bold;
}

.control-value {
    color: var(--yellow);
    font-size: 15px;
    -unity-font-style: bold;
}

.step-meter {
    height: 18px;
    margin-top: 16px;
    margin-bottom: 17px;
    flex-direction: row;
}

.meter-step {
    flex-grow: 1;
    height: 100%;
    margin-right: 5px;
    background-color: rgba(0, 240, 255, 0.08);
    border-width: 1px;
    border-color: rgba(0, 240, 255, 0.16);
    border-radius: 2px;
}

.meter-step.active {
    background-color: rgba(255, 196, 0, 0.62);
    border-color: var(--yellow);
}

.key-command-right {
    justify-content: flex-end;
}

.keycap {
    min-width: 30px;
    height: 28px;
    padding: 4px 8px;
    margin-right: 8px;
    background-color: rgba(255, 196, 0, 0.12);
    border-width: 1px;
    border-color: var(--yellow);
    border-radius: 3px;
    color: var(--yellow);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.key-command-label {
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
}

.system-note {
    margin-top: 18px;
    padding: 12px;
    background-color: rgba(0, 240, 255, 0.035);
    border-left-width: 2px;
    border-left-color: var(--cyan-soft);
}

.system-note-tag {
    margin-right: 10px;
    color: var(--cyan);
    font-size: 10px;
    -unity-font-style: bold;
}

.system-note-text {
    color: var(--muted);
    font-size: 10px;
}

.mission-complete {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 14, 18, 0.96);
}

.complete-mark {
    width: 72px;
    height: 72px;
    margin-bottom: 22px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 255, 128, 0.1);
    border-width: 2px;
    border-color: var(--green);
    border-radius: 36px;
}

.complete-mark-text {
    color: var(--green);
    font-size: 18px;
    -unity-font-style: bold;
}

.complete-title {
    color: var(--green);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.complete-subtitle {
    margin-top: 10px;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 1px;
}

.mission-complete.success-pulse {
    opacity: 1;
}

.satellite-sabotage-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.satellite-routing-section {
    flex-grow: 1;
    min-width: 0;
    margin-right: 24px;
}

.satellite-heading-row {
    height: 46px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.satellite-link-count {
    min-width: 118px;
    height: 30px;
    padding: 6px 10px;
    color: rgb(255, 176, 72);
    background-color: rgba(255, 176, 72, 0.07);
    border-width: 1px;
    border-color: rgba(255, 176, 72, 0.42);
    border-radius: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
}

.satellite-routing-canvas {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
    overflow: hidden;
    background-color: rgb(15, 4, 7);
    border-width: 1px;
    border-color: rgba(255, 61, 55, 0.3);
}

.satellite-orbit-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 182px;
}

.satellite-node {
    position: absolute;
    width: 15.5%;
    min-width: 104px;
    max-width: 148px;
    height: 174px;
    justify-content: flex-start;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.1s;
}

.satellite-position-0 {
    left: 1%;
    top: 24%;
}

.satellite-position-1 {
    left: 17.5%;
    top: 11%;
}

.satellite-position-2 {
    left: 34%;
    top: 3%;
}

.satellite-position-3 {
    left: 50.5%;
    top: 3%;
}

.satellite-position-4 {
    left: 67%;
    top: 11%;
}

.satellite-position-5 {
    left: 83.5%;
    top: 24%;
}

.satellite-node:hover {
    scale: 1.035 1.035;
}

.satellite-node.selected {
    scale: 1.075 1.075;
}

.satellite-node.cable-selected {
    scale: 1.055 1.055;
}

.satellite-dish-image {
    width: 124px;
    height: 124px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/SatelliteDishSabotage.png?fileID=2800000&guid=54b76b6f179e5884eaf8aa56be556051&type=3#SatelliteDishSabotage");
    -unity-background-scale-mode: scale-to-fit;
}

.satellite-dish-image.mirrored {
    scale: -1 1;
}

.satellite-name {
    margin-top: -5px;
    color: rgba(240, 220, 220, 0.55);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-code {
    margin-top: 1px;
    color: rgb(255, 222, 210);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-node.selected .satellite-code,
.satellite-node.cable-selected .satellite-code {
    color: rgb(255, 176, 72);
}

.satellite-node.connected .satellite-code {
    color: rgb(255, 95, 88);
}

.satellite-uplink-port {
    width: 18px;
    height: 6px;
    margin-top: 5px;
    flex-shrink: 0;
    background-color: rgb(20, 8, 11);
    border-width: 1px;
    border-color: rgba(126, 239, 244, 0.75);
    border-radius: 1px;
}

.satellite-node.selected .satellite-uplink-port,
.satellite-node.cable-selected .satellite-uplink-port {
    background-color: rgba(255, 176, 72, 0.24);
    border-color: rgb(255, 176, 72);
}

.satellite-node.connected .satellite-uplink-port {
    background-color: rgba(255, 61, 55, 0.3);
    border-color: rgb(255, 95, 88);
}

.computer-hub {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 182px;
    justify-content: flex-start;
    align-items: center;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 61, 55, 0.14);
}

.computer-port-shell {
    width: 440px;
    height: 55px;
    flex-shrink: 0;
    align-items: center;
}

.computer-port-caption {
    color: rgba(240, 220, 220, 0.48);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.computer-port-row {
    width: 100%;
    height: 36px;
    margin-top: 3px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.computer-port {
    width: 42px;
    height: 31px;
    justify-content: center;
    align-items: center;
    background-color: rgb(21, 6, 9);
    border-width: 1px;
    border-color: rgba(255, 61, 55, 0.34);
    border-radius: 2px;
}

.computer-port.occupied {
    background-color: rgba(255, 61, 55, 0.16);
    border-color: rgb(255, 95, 88);
}

.computer-port-number {
    color: rgba(240, 220, 220, 0.58);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.computer-port.occupied .computer-port-number {
    color: rgb(255, 222, 210);
}

.computer-connect-btn {
    width: 330px;
    height: 126px;
    margin-top: 4px;
    padding: 8px 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 61, 55, 0.055);
    border-width: 1px;
    border-color: rgba(255, 61, 55, 0.42);
    border-radius: 3px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

.computer-connect-btn:hover {
    background-color: rgba(255, 61, 55, 0.12);
    border-color: rgb(255, 95, 88);
    scale: 1.015 1.015;
}

.computer-connect-btn:disabled {
    opacity: 0.54;
}

.computer-icon-host {
    width: 112px;
    height: 90px;
    margin-right: 15px;
    flex-shrink: 0;
}

.computer-terminal-graphic {
    width: 100%;
    height: 100%;
}

.computer-core-title {
    position: absolute;
    left: 142px;
    top: 38px;
    color: rgb(255, 222, 210);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.computer-core-action {
    position: absolute;
    left: 142px;
    top: 61px;
    color: rgba(240, 220, 220, 0.5);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-order-panel {
    width: 350px;
    padding-left: 24px;
    border-left-width: 1px;
    border-left-color: rgba(255, 61, 55, 0.14);
}

.target-sequence-list {
    margin-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(255, 61, 55, 0.18);
}

.target-sequence-row {
    height: 39px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 61, 55, 0.11);
}

.target-sequence-number {
    width: 32px;
    color: rgb(255, 95, 88);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.target-sequence-line {
    width: 24px;
    height: 1px;
    margin-right: 14px;
    background-color: rgba(255, 61, 55, 0.46);
}

.target-sequence-code {
    color: rgb(255, 222, 210);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-status-block {
    margin-top: 16px;
    padding: 14px;
    background-color: rgba(255, 61, 55, 0.045);
    border-width: 1px;
    border-color: rgba(255, 61, 55, 0.17);
    border-left-width: 2px;
    border-left-color: rgb(255, 61, 55);
    border-radius: 2px;
}

.satellite-status-caption {
    color: rgba(240, 220, 220, 0.48);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-status {
    margin-top: 6px;
    color: rgb(255, 176, 72);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 0;
}

.satellite-status-divider {
    height: 1px;
    margin-top: 11px;
    margin-bottom: 9px;
    background-color: rgba(255, 61, 55, 0.14);
}

.satellite-selection-status {
    color: rgba(240, 220, 220, 0.58);
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 0;
}

.unlink-btn {
    height: 44px;
    margin-top: 14px;
    padding: 0 12px;
    color: rgb(255, 176, 72);
    background-color: rgba(255, 176, 72, 0.07);
    border-width: 1px;
    border-color: rgba(255, 176, 72, 0.48);
    border-radius: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.unlink-btn:hover {
    background-color: rgba(255, 176, 72, 0.16);
    border-color: rgb(255, 176, 72);
}

.unlink-btn:disabled {
    opacity: 0.42;
}

.satellite-system-note {
    margin-top: 14px;
    padding: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 61, 55, 0.03);
    border-left-width: 2px;
    border-left-color: rgba(255, 61, 55, 0.48);
}

.satellite-system-note-tag {
    margin-right: 9px;
    color: rgb(255, 95, 88);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.satellite-system-note-text {
    flex-grow: 1;
    color: rgba(240, 220, 220, 0.46);
    font-size: 8px;
    white-space: normal;
    letter-spacing: 0;
}

.wave-frequency-panel.sabotage-mode {
    background-color: rgb(16, 5, 8);
    border-color: rgba(255, 61, 55, 0.46);
}

.wave-frequency-panel.sabotage-mode .screen-header {
    border-bottom-color: rgba(255, 61, 55, 0.38);
}

.wave-frequency-panel.sabotage-mode .header-icon,
.wave-frequency-panel.sabotage-mode .connection-indicator {
    background-color: rgb(255, 61, 55);
}

.wave-frequency-panel.sabotage-mode .header-icon {
    border-radius: 2px;
    rotate: 45deg;
}

.wave-frequency-panel.sabotage-mode .header-title,
.wave-frequency-panel.sabotage-mode .connection-label {
    color: rgb(255, 95, 88);
}

.wave-frequency-panel.sabotage-mode .section-title {
    color: rgb(255, 222, 210);
    letter-spacing: 0;
}

.wave-frequency-panel.sabotage-mode .section-subtitle {
    color: rgba(240, 220, 220, 0.5);
    letter-spacing: 0;
}

.mission-complete.sabotage-success {
    background-color: rgba(20, 3, 6, 0.98);
}

.mission-complete.sabotage-success .complete-mark {
    background-color: rgba(255, 61, 55, 0.1);
    border-color: rgb(255, 61, 55);
}

.mission-complete.sabotage-success .complete-mark-text,
.mission-complete.sabotage-success .complete-title {
    color: rgb(255, 95, 88);
}
