.wave-frequency-panel.sabotage-mode {
    padding: 22px;
}

.wave-frequency-panel.sabotage-mode .screen-header {
    height: 64px;
    padding-bottom: 14px;
    margin-bottom: 16px;
}

.wave-frequency-panel.sabotage-mode .satellite-routing-section {
    margin-right: 18px;
}

.wave-frequency-panel.sabotage-mode .satellite-order-panel {
    width: 320px;
    padding-left: 18px;
}

.wave-frequency-panel.sabotage-mode .satellite-heading-row {
    height: 42px;
}

.wave-frequency-panel.sabotage-mode .satellite-routing-canvas {
    margin-top: 9px;
    border-radius: 3px;
}

.wave-frequency-panel.sabotage-mode .satellite-orbit-stage {
    bottom: 142px;
}

.wave-frequency-panel.sabotage-mode .satellite-node {
    width: 13.5%;
    min-width: 88px;
    max-width: 122px;
    height: 146px;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.wave-frequency-panel.sabotage-mode .satellite-position-0 {
    left: 2%;
    top: 8%;
}

.wave-frequency-panel.sabotage-mode .satellite-position-1 {
    left: 19%;
    top: 38%;
}

.wave-frequency-panel.sabotage-mode .satellite-position-2 {
    left: 35%;
    top: 4%;
}

.wave-frequency-panel.sabotage-mode .satellite-position-3 {
    left: 51%;
    top: 31%;
}

.wave-frequency-panel.sabotage-mode .satellite-position-4 {
    left: 68%;
    top: 7%;
}

.wave-frequency-panel.sabotage-mode .satellite-position-5 {
    left: 84%;
    top: 40%;
}

.wave-frequency-panel.sabotage-mode .satellite-dish-image {
    width: 102px;
    height: 102px;
    background-image: url("project://database/Assets/UI%20Toolkit/Images/SatelliteDishSabotageRed.png?fileID=2800000&guid=8d9ae5bdd034c1b449a4ee1dd62ac7bc&type=3#SatelliteDishSabotageRed");
}

.wave-frequency-panel.sabotage-mode .satellite-node:hover {
    scale: 1.055 1.055;
}

.wave-frequency-panel.sabotage-mode .satellite-node.dragging {
    scale: 1.11 1.11;
    opacity: 0.86;
}

.wave-frequency-panel.sabotage-mode .satellite-node.dragging .satellite-uplink-port {
    background-color: rgba(255, 112, 55, 0.42);
    border-color: rgb(255, 142, 72);
}

.wave-frequency-panel.sabotage-mode .computer-hub {
    height: 142px;
    padding: 12px 18px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.wave-frequency-panel.sabotage-mode .computer-port-shell {
    width: 470px;
    height: 70px;
    margin-right: 24px;
}

.wave-frequency-panel.sabotage-mode .computer-port-caption {
    margin-bottom: 5px;
    color: rgba(255, 180, 165, 0.7);
    font-size: 9px;
}

.wave-frequency-panel.sabotage-mode .computer-port-row {
    height: 42px;
    margin-top: 0;
}

.wave-frequency-panel.sabotage-mode .computer-port {
    width: 54px;
    height: 38px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.08s;
}

.wave-frequency-panel.sabotage-mode .computer-port.drop-target {
    scale: 1.14 1.14;
}

.wave-frequency-panel.sabotage-mode .computer-port.drop-valid {
    background-color: rgba(255, 142, 72, 0.27);
    border-color: rgb(255, 142, 72);
}

.wave-frequency-panel.sabotage-mode .computer-port.drop-blocked {
    background-color: rgba(255, 35, 35, 0.34);
    border-color: rgb(255, 35, 35);
}

.wave-frequency-panel.sabotage-mode .computer-connect-btn {
    width: 270px;
    height: 104px;
    margin-top: 0;
    padding: 8px 14px;
    flex-shrink: 0;
    background-color: rgba(255, 61, 55, 0.075);
}

.wave-frequency-panel.sabotage-mode .computer-connect-btn:hover {
    scale: 1 1;
}

.wave-frequency-panel.sabotage-mode .computer-icon-host {
    width: 90px;
    height: 78px;
    margin-right: 12px;
}

.wave-frequency-panel.sabotage-mode .computer-core-title {
    left: 116px;
    top: 31px;
    font-size: 13px;
}

.wave-frequency-panel.sabotage-mode .computer-core-action {
    left: 116px;
    right: 10px;
    top: 54px;
    font-size: 8px;
    white-space: normal;
}

.wave-frequency-panel.sabotage-mode .target-sequence-list {
    margin-top: 10px;
}

.wave-frequency-panel.sabotage-mode .target-sequence-row {
    height: 34px;
}

.wave-frequency-panel.sabotage-mode .satellite-status-block {
    margin-top: 12px;
    padding: 11px;
}

.wave-frequency-panel.sabotage-mode .satellite-status {
    margin-top: 4px;
    font-size: 15px;
}

.wave-frequency-panel.sabotage-mode .unlink-btn {
    height: 40px;
    margin-top: 11px;
}

.wave-frequency-panel.sabotage-mode .satellite-system-note {
    margin-top: 11px;
    padding: 8px;
}