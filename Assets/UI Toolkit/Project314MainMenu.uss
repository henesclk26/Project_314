:root {
    --hull: rgb(17, 20, 16);
    --hull-deep: rgb(10, 12, 10);
    --hull-raised: rgb(26, 30, 23);
    --hull-line: rgba(232, 239, 213, 0.12);
    --hull-line-soft: rgba(232, 239, 213, 0.06);
    --phosphor: rgb(178, 255, 85);
    --phosphor-soft: rgba(178, 255, 85, 0.14);
    --ivory: rgb(238, 241, 224);
    --secondary: rgba(226, 232, 203, 0.66);
    --muted: rgba(226, 232, 203, 0.38);
    --amber: rgb(255, 189, 72);
    --red: rgb(246, 100, 82);
}

.topbar-name,
.topbar-meta,
.status-text,
.os-title,
.os-subtitle,
.diagnostic-label,
.diagnostic-value,
.session-title,
.session-meta,
.mode-index,
.mode-kicker,
.mode-button,
.mode-detail,
.ticker-label,
.ticker-message,
.utility-button {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Resources/Fonts%20%26%20Materials/Orbitron-VariableFont_wght.ttf?fileID=12800000&guid=4fff0ea22d9a9894389a3116ec5368fe&type=3#Orbitron-VariableFont_wght");
}

.os-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--hull);
}

.terminal-grid,
.os-main,
.os-bottom {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.terminal-grid {
    opacity: 0.72;
}

.grid-line,
.grid-rail {
    position: absolute;
    background-color: var(--hull-line-soft);
}

.grid-line {
    left: 0;
    right: 0;
    height: 1px;
}

.grid-line-top {
    top: 28%;
}

.grid-line-middle {
    top: 56%;
}

.grid-line-bottom {
    top: 78%;
}

.grid-rail {
    top: 52px;
    bottom: 92px;
    width: 1px;
}

.grid-rail-left {
    left: 8%;
}

.grid-rail-right {
    right: 8%;
}

.os-topbar {
    position: absolute;
    left: 32px;
    top: 0;
    right: 32px;
    height: 52px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--hull-line);
}

.topbar-cluster,
.status-indicator {
    flex-direction: row;
    align-items: center;
}

.topbar-cluster-right {
    justify-content: flex-end;
}

.system-mark {
    width: 15px;
    height: 15px;
    margin-right: 10px;
    padding: 3px;
    background-color: var(--phosphor-soft);
    border-width: 1px;
    border-color: var(--phosphor);
}

.system-mark-core {
    width: 100%;
    height: 100%;
    background-color: var(--phosphor);
}

.topbar-name {
    color: var(--ivory);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.topbar-meta {
    margin-left: 14px;
    color: var(--muted);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.topbar-build {
    margin-left: 18px;
}

.status-indicator {
    margin-left: 10px;
    padding: 5px 8px;
    background-color: rgba(178, 255, 85, 0.05);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.25);
}

.status-light {
    width: 5px;
    height: 5px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: var(--phosphor);
}

.status-text {
    color: var(--phosphor);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.os-main {
    top: 52px;
    bottom: 94px;
    align-items: center;
    justify-content: center;
}

.title-block {
    width: 720px;
    align-items: center;
}

.os-title {
    color: var(--ivory);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 0;
    -unity-text-align: middle-center;
}

.title-rule {
    width: 100%;
    height: 1px;
    margin-top: 12px;
    background-color: var(--hull-line);
}

.title-rule-core {
    width: 108px;
    height: 2px;
    margin-top: -1px;
    margin-left: 306px;
    background-color: var(--phosphor);
}

.os-subtitle {
    margin-top: 10px;
    color: var(--secondary);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
}

.diagnostic-row {
    width: 720px;
    height: 50px;
    margin-top: 28px;
    flex-direction: row;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--hull-line);
}

.diagnostic-cell {
    flex-grow: 1;
    padding: 10px 14px;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: var(--hull-line-soft);
}

.diagnostic-cell-last {
    border-right-width: 0;
}

.diagnostic-label {
    color: var(--muted);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.diagnostic-value {
    margin-top: 4px;
    color: var(--phosphor);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.diagnostic-warning {
    color: var(--amber);
}

.diagnostic-muted {
    color: var(--secondary);
}

.session-section {
    width: 880px;
    margin-top: 34px;
}

.session-heading {
    height: 24px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.session-title {
    color: var(--ivory);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.session-meta {
    color: var(--muted);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.mode-grid {
    height: 174px;
    flex-direction: row;
    align-items: stretch;
}

.mode-column {
    flex-grow: 1;
}

.mode-header {
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.mode-index {
    width: 28px;
    color: var(--phosphor);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.mode-kicker {
    color: var(--secondary);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.mode-button {
    height: 112px;
    color: var(--ivory);
    background-color: var(--hull-raised);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.48);
    border-left-width: 4px;
    border-left-color: var(--phosphor);
    border-radius: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.mode-button:hover,
.mode-button:focus {
    color: rgb(15, 19, 13);
    background-color: var(--phosphor);
    border-color: var(--phosphor);
}

.mode-button:active {
    scale: 0.985 0.985;
}

.mode-button:disabled {
    color: var(--muted);
    background-color: rgba(255, 255, 255, 0.025);
    border-color: var(--hull-line);
}

.mode-detail {
    margin-top: 9px;
    color: var(--muted);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.mode-separator {
    width: 42px;
    align-items: center;
    justify-content: center;
}

.mode-separator-mark {
    width: 1px;
    height: 112px;
    margin-top: 28px;
    background-color: var(--hull-line);
}

.os-bottom {
    top: auto;
    height: 94px;
    padding: 0 32px;
    background-color: var(--hull-deep);
    border-top-width: 1px;
    border-top-color: var(--hull-line);
}

.mission-ticker {
    height: 38px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--hull-line-soft);
}

.ticker-signal {
    width: 7px;
    height: 7px;
    margin-right: 9px;
    background-color: var(--amber);
}

.ticker-label {
    color: var(--amber);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.ticker-message {
    margin-left: 16px;
    color: var(--secondary);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.utility-strip {
    height: 55px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.utility-button {
    min-width: 136px;
    height: 38px;
    padding: 0 14px;
    color: var(--secondary);
    background-color: rgba(255, 255, 255, 0.015);
    border-width: 1px;
    border-color: rgba(232, 239, 213, 0.14);
    border-radius: 0;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.utility-button:hover,
.utility-button:focus {
    color: var(--ivory);
    background-color: rgba(238, 241, 224, 0.1);
    border-color: rgba(238, 241, 224, 0.48);
}

.utility-button:active {
    scale: 0.97 0.97;
}

.utility-button-test {
    color: var(--amber);
    border-color: rgba(255, 189, 72, 0.35);
}

.utility-button-test:hover,
.utility-button-test:focus {
    color: rgb(22, 18, 10);
    background-color: var(--amber);
    border-color: var(--amber);
}

.utility-button-quit {
    color: rgba(246, 150, 137, 0.82);
    border-color: rgba(246, 100, 82, 0.28);
}

.utility-button-quit:hover,
.utility-button-quit:focus {
    color: rgb(28, 12, 10);
    background-color: var(--red);
    border-color: var(--red);
}

.utility-divider {
    width: 1px;
    height: 18px;
    margin: 0 9px;
    background-color: var(--hull-line-soft);
}

/* Settings overlay */
.settings-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 10, 0.93);
}

.settings-card {
    width: 620px;
    padding: 42px 46px 34px 46px;
    background-color: var(--hull-raised);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.56);
    border-left-width: 4px;
    border-left-color: var(--phosphor);
}

.settings-title {
    color: var(--phosphor);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.settings-subtitle {
    margin-top: 8px;
    color: var(--muted);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-separator {
    height: 1px;
    margin-top: 25px;
    margin-bottom: 8px;
    background-color: var(--hull-line);
}

.settings-row {
    min-height: 62px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--hull-line-soft);
}

.settings-label {
    color: var(--ivory);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-dropdown,
.settings-toggle {
    width: 230px;
    min-height: 36px;
    color: var(--phosphor);
    background-color: var(--hull-deep);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.35);
}

.settings-toggle {
    padding-left: 12px;
}

.settings-hint {
    margin-top: 24px;
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-back-button {
    width: 150px;
    height: 42px;
    margin-top: 24px;
    align-self: flex-end;
    color: var(--amber);
    background-color: rgba(255, 189, 72, 0.08);
    border-width: 1px;
    border-color: rgba(255, 189, 72, 0.42);
    border-radius: 0;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-back-button:hover {
    color: var(--hull-deep);
    background-color: var(--amber);
    border-color: var(--amber);
}

/* Full-screen settings console */
.settings-overlay {
    align-items: stretch;
    justify-content: stretch;
    background-color: rgba(10, 12, 10, 0.97);
}

.settings-screen {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--hull);
}

.settings-sidebar {
    width: 29%;
    min-width: 260px;
    padding: 70px 42px 42px 54px;
    background-color: var(--hull-deep);
    border-right-width: 1px;
    border-right-color: var(--hull-line);
}

.settings-title {
    color: var(--ivory);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-subtitle {
    margin-top: 12px;
    color: var(--phosphor);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-back-button {
    width: 178px;
    height: 50px;
    margin-top: 38px;
    align-self: flex-start;
    color: var(--amber);
    background-color: rgba(255, 189, 72, 0.08);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(255, 189, 72, 0.36);
    border-left-color: var(--amber);
    border-radius: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-back-button:hover {
    color: var(--hull-deep);
    background-color: var(--amber);
    border-color: var(--amber);
}

.settings-sidebar-spacer { flex-grow: 1; }

.settings-sidebar-label {
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-sidebar-value {
    margin-top: 8px;
    color: var(--phosphor);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.settings-status-line {
    width: 100%;
    height: 2px;
    margin-top: 16px;
    background-color: rgba(178, 255, 85, 0.34);
}

.settings-main {
    flex-grow: 1;
    min-width: 0;
    padding: 34px 46px 46px 34px;
}

.settings-tabs {
    height: 58px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--hull-line);
}

.settings-tab {
    flex-grow: 1;
    height: 46px;
    margin-right: 10px;
    color: var(--secondary);
    background-color: var(--hull-raised);
    border-width: 1px;
    border-color: var(--hull-line);
    border-radius: 0;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.settings-tab:hover,
.settings-tab:focus {
    color: var(--phosphor);
    border-color: rgba(178, 255, 85, 0.55);
    background-color: var(--phosphor-soft);
}

.settings-tab-active,
.settings-tab-active:hover,
.settings-tab-active:focus {
    color: var(--hull-deep);
    background-color: var(--phosphor);
    border-color: var(--phosphor);
}

.settings-tab-disabled,
.settings-tab-disabled:hover,
.settings-tab-disabled:focus {
    color: var(--muted);
    background-color: rgba(255, 255, 255, 0.025);
    border-color: var(--hull-line-soft);
}

.settings-content { flex-grow: 1; padding-top: 36px; }

.settings-content-title {
    color: var(--ivory);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-content-subtitle {
    margin-top: 8px;
    color: var(--phosphor);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-list { margin-top: 28px; }

.settings-row {
    min-height: 92px;
    margin-bottom: 10px;
    padding: 18px 22px;
    flex-direction: row;
    align-items: center;
    background-color: var(--hull-raised);
    border-left-width: 3px;
    border-left-color: rgba(178, 255, 85, 0.34);
    border-top-width: 1px;
    border-top-color: var(--hull-line-soft);
}

.settings-row-copy { flex-grow: 1; min-width: 0; justify-content: center; }

.settings-label {
    color: var(--ivory);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.settings-detail {
    margin-top: 7px;
    color: var(--muted);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.settings-dropdown,
.settings-toggle {
    width: 400px;
    min-height: 50px;
    margin-left: 28px;
    color: var(--phosphor);
    background-color: var(--hull-deep);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.42);
}

.settings-toggle { padding-left: 16px; }

.settings-fps-control {
    width: 400px;
    min-width: 400px;
    min-height: 50px;
    margin-left: 28px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--hull-deep);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.42);
}

.settings-fps-slider {
    flex-grow: 1;
    min-width: 0;
    height: 20px;
}

.settings-fps-slider .unity-base-slider__tracker {
    height: 6px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.24);
    border-radius: 3px;
}

.settings-fps-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    margin-top: -6px;
    background-color: var(--phosphor);
    border-radius: 50%;
}

.settings-fps-slider .unity-base-slider__fill {
    height: 6px;
    background-color: rgba(178, 255, 85, 0.38);
    border-radius: 3px;
}

.settings-fps-value {
    width: 84px;
    margin-left: 10px;
    color: var(--phosphor);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.settings-save-button {
    width: 178px;
    height: 50px;
    margin-top: 10px;
    align-self: flex-start;
    color: var(--phosphor);
    background-color: rgba(178, 255, 85, 0.08);
    border-width: 1px;
    border-color: rgba(178, 255, 85, 0.65);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-save-button:hover,
.settings-save-button:focus {
    color: var(--hull-deep);
    background-color: var(--phosphor);
    border-color: var(--phosphor);
}

.settings-save-saving,
.settings-save-saving:hover,
.settings-save-saving:focus {
    color: var(--hull-deep);
    background-color: rgb(0, 160, 255);
    border-color: rgb(0, 210, 255);
}

.settings-save-complete,
.settings-save-complete:hover,
.settings-save-complete:focus {
    color: var(--muted);
    background-color: rgba(150, 165, 180, 0.16);
    border-color: rgba(180, 195, 210, 0.5);
}

.settings-hint {
    margin-top: 22px;
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
